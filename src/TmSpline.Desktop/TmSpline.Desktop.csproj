<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The TMSpline desktop app: the editor in a window (Photino: WebView2 on Windows, WebKit on macOS/Linux) and, inside
    the same process, the TMSpline server for everything that touches the game on the user's machine (NadeoImporter,
    export to game, live update, the block library). The built editor (web/dist) is copied to wwwroot.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TMSpline</AssemblyName>
    <RootNamespace>TmSpline.Desktop</RootNamespace>
    <Version>0.1.0</Version>
    <!-- The server and VanillaLib are executables too; they run inside this one. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <EditorDist>$(MSBuildThisFileDirectory)..\..\web\dist</EditorDist>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <ProjectReference Include="..\TmSpline.Server\TmSpline.Server.csproj" />
    <ProjectReference Include="..\..\tools\VanillaLib\VanillaLib.csproj" />
  </ItemGroup>

  <!-- The server's own settings are for running it standalone; the app configures it in code. -->
  <Target Name="DropServerSettings" AfterTargets="Build;Publish">
    <Delete Files="$(OutDir)appsettings.json;$(OutDir)appsettings.Development.json" />
    <Delete Files="$(PublishDir)appsettings.json;$(PublishDir)appsettings.Development.json" Condition="'$(PublishDir)' != ''" />
  </Target>

  <!--
    The built editor (web/dist → wwwroot). Building the app rebuilds it whenever its sources changed, and the preview
    core (web/public/_framework) whenever TmSpline.Core or TmSpline.Wasm changed; web/dist is not in git, so an old one
    would otherwise ship silently. BuildEditor=false skips both (then whatever web/dist holds is used).
  -->
  <PropertyGroup>
    <WebDir>$(MSBuildThisFileDirectory)..\..\web</WebDir>
    <BuildEditor Condition="'$(BuildEditor)' == ''">true</BuildEditor>
  </PropertyGroup>
  <ItemGroup>
    <EditorSource Include="$(WebDir)\src\**;$(WebDir)\index.html;$(WebDir)\public\**;$(WebDir)\package.json;$(WebDir)\vite.config.*" Exclude="$(WebDir)\public\_framework\**" />
    <PreviewCoreSource Include="$(MSBuildThisFileDirectory)..\TmSpline.Core\**\*.cs;$(MSBuildThisFileDirectory)..\TmSpline.Core\*.csproj;$(MSBuildThisFileDirectory)..\TmSpline.Wasm\**\*.cs;$(MSBuildThisFileDirectory)..\TmSpline.Wasm\*.csproj"
                       Exclude="$(MSBuildThisFileDirectory)..\**\bin\**;$(MSBuildThisFileDirectory)..\**\obj\**" />
  </ItemGroup>
  <Target Name="InstallEditorPackages" BeforeTargets="BuildPreviewCore" Condition="'$(BuildEditor)' == 'true' And !Exists('$(WebDir)\node_modules')">
    <Exec Command="npm install" WorkingDirectory="$(WebDir)" />
  </Target>
  <Target Name="BuildPreviewCore" BeforeTargets="BuildEditorBundle" Condition="'$(BuildEditor)' == 'true'"
          Inputs="@(PreviewCoreSource)" Outputs="$(WebDir)\public\_framework\TmSpline.Core.wasm">
    <Exec Command="npm run wasm" WorkingDirectory="$(WebDir)" />
  </Target>
  <Target Name="BuildEditorBundle" BeforeTargets="BeforeBuild" Condition="'$(BuildEditor)' == 'true'"
          Inputs="@(EditorSource);$(WebDir)\public\_framework\TmSpline.Core.wasm" Outputs="$(EditorDist)\index.html">
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" />
  </Target>
  <!-- Collected after the bundle is built, so a fresh build is copied the same run. -->
  <Target Name="CopyEditor" AfterTargets="BuildEditorBundle" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_EditorFile Include="$(EditorDist)\**" />
      <Content Include="@(_EditorFile)" Link="wwwroot\%(_EditorFile.RecursiveDir)%(_EditorFile.Filename)%(_EditorFile.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="WarnNoEditor" BeforeTargets="Build" Condition="!Exists('$(EditorDist)\index.html')">
    <Warning Text="web/dist is missing: the app has no editor to show (BuildEditor=false, or the npm build failed)." />
  </Target>

</Project>
