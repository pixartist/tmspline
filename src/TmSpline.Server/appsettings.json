{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Export": {
    "ImporterMode": "Wine",
    "ImporterDir": "/opt/nadeo-importer",
    "WineCommand": "wine",
    "DockerImage": "tmspline-importer",
    "WorkDir": "/tmp/tmspline-jobs",
    "TemplatePath": "Templates/Empty48.Map.Gbx",
    "MaxConcurrentJobs": 2,
    "MaxQueuedJobs": 8,
    "MaxPoints": 400,
    "MaxLengthMeters": 20000,
    "TimeoutSeconds": 300,
    "KeepJobFiles": false,
    "RequestsPerMinute": 10
  }
}
